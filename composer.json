{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "threadable/qality-plus",
    "description": "Laravel and PHPUnit integration for publishing automated test results to QAlity Plus.",
    "keywords": [
        "laravel",
        "phpunit",
        "qality",
        "jira",
        "testing"
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.1",
        "phpunit/phpunit": "^12.5|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Threadable\\QalityPlus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Threadable\\QalityPlus\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test",
        "test": "vendor/bin/phpunit",
        "ci": [
            "@lint",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Threadable\\QalityPlus\\QalityPlusServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
