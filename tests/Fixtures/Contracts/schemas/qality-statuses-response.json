{
    "type": "object",
    "required": ["statuses"],
    "properties": {
        "statuses": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["id", "name", "category"],
                "properties": {
                    "id": {"type": "integer"},
                    "name": {"type": "string", "minLength": 1},
                    "category": {
                        "type": "string",
                        "enum": ["PASSED", "FAILED", "UNFINISHED", "FINISHED"]
                    }
                }
            }
        }
    }
}
